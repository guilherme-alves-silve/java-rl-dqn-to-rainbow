# Generated by AI
# syntax=docker/dockerfile:1
#
# A single image for everything: training, evaluation, unit tests and the stable-retro
# integration tests.
#
#   docker compose build
#   docker compose run --rm train        # trains the agent (GPU)
#   docker compose run --rm test         # the unit tests
#   docker compose run --rm test-retro   # the stable-retro integration tests (Linux only)
#
# The image carries the ENVIRONMENT (JDK, Python, the Python packages and the Maven
# dependencies). The CODE is not baked in: it is mounted as a volume, so changing a
# line of Java does not require a rebuild.
#
# The toolchain that compiles the stable-retro core (cmake/g++) lives in the build
# stage only: the final image has the compiled wheel, not the compiler.

# ---------------------------------------------------------------------------
# Stage 1: the Python environment (gymnasium, shimmy and the stable-retro core)
# ---------------------------------------------------------------------------
FROM eclipse-temurin:25-jdk AS python-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        python3-dev \
        build-essential \
        cmake \
        git \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Python 3.12 must match the embedded CPython of the JVM (cpython 3.12.1 / JavaCPP),
# otherwise the compiled extensions of the site-packages are not loadable.
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip wheel \
    && /opt/venv/bin/pip install --no-cache-dir \
        "gymnasium[atari,other]==0.29.1" \
        "shimmy>=2.1.0" \
        "ale-py==0.10.1" \
        "autorom[accept-rom-license]" \
        "numpy<2.0" \
    && /opt/venv/bin/pip install --no-cache-dir stable-retro

# ---------------------------------------------------------------------------
# Stage 2: the Maven dependencies of the project (so the container runs offline)
# ---------------------------------------------------------------------------
FROM eclipse-temurin:25-jdk AS maven-builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends maven \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY pom.xml .
RUN mvn -B -q dependency:go-offline || true

# ---------------------------------------------------------------------------
# Stage 3: the CUDA runtime (the DJL PyTorch native needs it)
# ---------------------------------------------------------------------------
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu24.04 AS cuda

# ---------------------------------------------------------------------------
# Stage 4: the image
# ---------------------------------------------------------------------------
FROM eclipse-temurin:25-jdk AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        maven \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 \
        libxrender1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# The Python environment (with the compiled stable-retro core and the ROMs)
COPY --from=python-builder /opt/venv /opt/venv
ENV JAVA_RL_SITE_PACKAGES=/opt/venv/lib/python3.12/site-packages
ENV PATH=/opt/venv/bin:${PATH}

# The pre-fetched Maven dependencies (a named volume on /root/.m2 keeps them updated)
COPY --from=maven-builder /root/.m2 /root/.m2

# The CUDA libraries
COPY --from=cuda /usr/local/cuda-12.4 /usr/local/cuda-12.4
ENV LD_LIBRARY_PATH=/usr/local/cuda-12.4/lib64:${LD_LIBRARY_PATH}

WORKDIR /build
COPY docker/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# The outputs are mounted from the host
VOLUME ["/app/output_models", "/app/output_evaluations", "/app/docs"]

ENTRYPOINT ["/app/entrypoint.sh"]
